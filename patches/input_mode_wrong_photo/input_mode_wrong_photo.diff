+    def _loaded_frame_is_current(self) -> bool:
+        """False when the selected frame is not the one last DECODED. Sorting
+        shows each frame's thumbnail and applies its look but skips the
+        decode, and a failed load keeps the previous frame's pixels: the input
+        layers -- and any render or kept print made from them -- then belong
+        to another frame."""
+        current = self._current_input_path
+        if not current:
+            return True
+        loaded = self._loaded_input_path
+        return loaded is not None and (
+            os.path.normcase(os.path.abspath(loaded))
+            == os.path.normcase(os.path.abspath(current)))
+
+    def _load_selected_frame(self, *, render_follows: bool = False) -> bool:
+        """Before anything that renders, edits or writes the selected frame's
+        pixels, make sure they are its own: from sorting, leave input mode
+        (what picking Print does), else load it. False when it could not be
+        loaded, so the caller stops instead of using another frame's pixels
+        under this one's name."""
+        # A render from sorting also leaves it, properly: the finished render
+        # only cleared the flag, leaving the side panels hidden and locked.
+        if self._loaded_frame_is_current() and not (render_follows and self._input_mode):
+            return True
+        if self._input_mode:
+            self.set_input_mode(False)
+        elif self._roll.current is not None:
+            self._roll_load_current(restore_state=False)    # the panels are its look
+        else:
+            self._reload_current_input()
+        if not self._loaded_frame_is_current():
+            set_status(self._viewer, 'Could not load the selected frame')
+            return False
+        # The load queued an auto preview. A caller that renders anyway does
+        # not want it replayed after its own render (it replaced a Scan).
+        if render_follows and self._auto_preview_scheduled:
+            self._skip_scheduled_auto_preview = True
+        return True
+
